void schedule.sfr_reconcile()
{
	// ==================================================================
	// function_name     : sfr_reconcile
	// category          : schedule（制限時間 15 分。実行間隔は仮置き1時間ごと、D19）
	// arguments         : なし
	// return            : void
	// motivation        : 全親を id 順に sfr_sync_core で完全同期し直し、発火しない変更・部分失敗・手での改変・
	//                     孤児ミラーを修復する簡素な照合（仕様 v0.2 §6-7、ESC-3）
	// processing_flow   : 1 SFR_Sync_State を読む（前回が2周期より古いか）→ 2 SFR_Projects を id 順に COQL でページング取得
	//                     → 3 親ごとに sfr_sync_core(親ID, "reconcile")（failed は飛ばす。件数・時間・行数の上限で区切る）
	//                     → 4 孤児ミラーの検出（親一覧に無い Parent_Record_Id を sfr_sync_core の親不在判定へ回す）
	//                     → 5 synced 以外の親を COQL COUNT で数え、照合ログを1件 Insert、SFR_Sync_State を更新
	// related_functions : sfr_sync_core（standalone 本体）
	// 注意              : 打ち切ったら次回は続きからではなく先頭から回す。COQL は直列（サブ同時実行 10 本まで）
	// ==================================================================
	//
	// ---------- 定数 ----------
	API_BASE = "https://www.zohoapis.jp/crm/v8";
	CONN = "crm_module";
	PARENT_MODULE = "SFR_Projects";
	MIRROR_MODULE = "SFR_Line_Mirrors";
	LOG_MODULE = "SFR_Sync_Logs";
	STATE_MODULE = "SFR_Sync_State";
	STATE_NAME = "reconcile";
	MAX_PARENTS_PER_RUN = 100;
	// 15 分（900 秒）に対して余裕を残して打ち切る秒数（P0-10 の実測後に見直す）
	DEADLINE_SEC = 780;
	// 1回の実行で同期する行数の目安（処理行数 200,000 の上限対策。P0-10 の実測後に見直す）
	ROWS_BUDGET_PER_RUN = 1500;
	PARENT_PAGE_LIMIT = 200;
	MAX_PARENT_PAGES = 50;
	MIRROR_PAGE_LIMIT = 2000;
	MAX_MIRROR_PAGES = 20;
	ORPHAN_SCAN = true;
	RUN_INTERVAL_HOURS = 1;
	TEXT_MAX = 255;
	ERROR_DETAIL_MAX = 2000;
	ISO_FMT = "yyyy-MM-dd'T'HH:mm:ssXXX";
	CODE_SUCCESS = "SUCCESS";
	ST_FAILED = "failed";
	//
	coqlUrl = API_BASE + "/coql";
	logUrl = API_BASE + "/" + LOG_MODULE;
	stateUrl = API_BASE + "/" + STATE_MODULE;
	startMs = zoho.currenttime.toLong();
	startedAt = zoho.currenttime.toString(ISO_FMT);
	runStamp = zoho.currenttime.toString("yyyyMMddHHmmss");
	//
	runResult = "success";
	notes = List();
	stateId = "";
	prevLastRun = "";
	staleRun = false;
	parentIds = List();
	parentSet = Map();
	listingDone = false;
	listingComplete = false;
	listingFailed = false;
	stopAll = false;
	stopReason = "";
	processedCount = 0;
	rowsProcessed = 0;
	successCount = 0;
	partialCount = 0;
	failedCount = 0;
	skippedCount = 0;
	outOfSpecCount = 0;
	repairedCount = 0;
	needsResyncLeft = 0;
	newlyFailedCount = 0;
	skippedFailedCount = 0;
	orphanParentCount = 0;
	orphanCleanedCount = 0;
	orphanInvalidCount = 0;
	totalAdded = 0;
	totalUpdated = 0;
	totalDeleted = 0;
	nonSyncedCount = "";
	//
	try
	{
		// ---------- 1. 照合状態を読む ----------
		sq = "select id, Name, Last_Run_At from " + STATE_MODULE + " where Name = '" + STATE_NAME + "' limit 1";
		sBody = Map();
		sBody.put("select_query",sq);
		sBodyStr = sBody.toString();
		sResp = invokeurl
		[
			url :coqlUrl
			type :POST
			parameters:sBodyStr
			connection:"crm_module"
		];
		sStr = ifnull(sResp,"").toString();
		if(sStr != "")
		{
			sMap = sStr.toMap();
			sCode = ifnull(sMap.get("code"),"").toString();
			if(sCode != "")
			{
				notes.add("STATE_READ_FAILED code=" + sCode);
			}
			else
			{
				sData = sMap.get("data");
				if(sData != null)
				{
					if(sData.size() > 0)
					{
						sFirst = sData.get(0);
						stateId = ifnull(sFirst.get("id"),"").toString();
						prevLastRun = ifnull(sFirst.get("Last_Run_At"),"").toString();
					}
				}
			}
		}
		// 前回の終了時刻が照合間隔の2周期より古いか（照合が止まっていた形跡）
		if(prevLastRun != "")
		{
			staleHours = 0 - 2 * RUN_INTERVAL_HOURS;
			threshold = zoho.currenttime.addHour(staleHours).toString(ISO_FMT);
			tq = "select COUNT(id) from " + STATE_MODULE + " where (Name = '" + STATE_NAME + "' and Last_Run_At < '" + threshold + "')";
			tBody = Map();
			tBody.put("select_query",tq);
			tBodyStr = tBody.toString();
			tResp = invokeurl
			[
				url :coqlUrl
				type :POST
				parameters:tBodyStr
				connection:"crm_module"
			];
			tStr = ifnull(tResp,"").toString();
			if(tStr != "")
			{
				tMap = tStr.toMap();
				tData = tMap.get("data");
				if(tData != null)
				{
					if(tData.size() > 0)
					{
						tFirst = tData.get(0);
						tCount = ifnull(tFirst.get("COUNT(id)"),"0").toString();
						if(tCount != "0")
						{
							staleRun = true;
						}
					}
				}
			}
		}
		//
		// ---------- 2. 親の一覧（id 順、LIMIT 付きのページング。続きは id > 前ページの最後の id） ----------
		slotStr = "".leftPad(MAX_PARENT_PAGES).replaceAll(" ","x,");
		slotLen = slotStr.length() - 1;
		slotStr = slotStr.subString(0,slotLen);
		pageSlots = slotStr.toList(",");
		lastParentId = "";
		for each  pageSlot in pageSlots
		{
			if(listingDone == false)
			{
				whereClause = "id is not null";
				if(lastParentId != "")
				{
					whereClause = "id > '" + lastParentId + "'";
				}
				pq = "select id, Mirror_Sync_Status from " + PARENT_MODULE + " where " + whereClause + " order by id asc limit " + PARENT_PAGE_LIMIT;
				pBody = Map();
				pBody.put("select_query",pq);
				pBodyStr = pBody.toString();
				pResp = invokeurl
				[
					url :coqlUrl
					type :POST
					parameters:pBodyStr
					connection:"crm_module"
				];
				pStr = ifnull(pResp,"").toString();
				if(pStr == "")
				{
					// 0 件は 204（本文なし）。次のページが無いという意味
					listingDone = true;
					listingComplete = true;
				}
				else
				{
					pMap = pStr.toMap();
					pCode = ifnull(pMap.get("code"),"").toString();
					if(pCode != "")
					{
						listingDone = true;
						listingFailed = true;
						notes.add("PARENT_LIST_FAILED code=" + pCode);
					}
					else
					{
						pData = pMap.get("data");
						if(pData == null)
						{
							listingDone = true;
							listingComplete = true;
						}
						else
						{
							for each  pr in pData
							{
								prId = ifnull(pr.get("id"),"").toString();
								if(prId != "")
								{
									prStatus = ifnull(pr.get("Mirror_Sync_Status"),"").toString();
									parentIds.add(prId);
									parentSet.put(prId,prStatus);
									lastParentId = prId;
								}
							}
							pInfo = pMap.get("info");
							pMore = "";
							if(pInfo != null)
							{
								pMore = ifnull(pInfo.get("more_records"),"").toString();
							}
							if(pMore != "true")
							{
								listingDone = true;
								listingComplete = true;
							}
						}
					}
				}
			}
		}
		if(listingDone == false)
		{
			notes.add("PARENT_LIST_TRUNCATED pages=" + MAX_PARENT_PAGES);
		}
		//
		// ---------- 3. 全親の完全同期（id 順に1件ずつ。failed は飛ばす） ----------
		for each  targetId in parentIds
		{
			if(stopAll == false)
			{
				tStatus = parentSet.get(targetId);
				if(tStatus == ST_FAILED)
				{
					skippedFailedCount = skippedFailedCount + 1;
				}
				else
				{
					nowMs = zoho.currenttime.toLong();
					elapsedSec = (nowMs - startMs) / 1000;
					if(processedCount >= MAX_PARENTS_PER_RUN)
					{
						stopAll = true;
						stopReason = "MAX_PARENTS_PER_RUN";
					}
					else if(elapsedSec >= DEADLINE_SEC)
					{
						stopAll = true;
						stopReason = "DEADLINE";
					}
					else if(rowsProcessed >= ROWS_BUDGET_PER_RUN)
					{
						stopAll = true;
						stopReason = "ROWS_BUDGET";
					}
					else
					{
						ret = standalone.sfr_sync_core(targetId,"reconcile");
						processedCount = processedCount + 1;
						retText = ifnull(ret,"").toString();
						retParts = retText.toList(";");
						rRes = "";
						rSt = "";
						rW = "0";
						partNo = 0;
						for each  rp in retParts
						{
							partNo = partNo + 1;
							if(partNo == 1)
							{
								rRes = rp.replaceAll("_","");
							}
							else if(rp.startsWith("st="))
							{
								rSt = rp.getSuffix("=").replaceAll("_","");
							}
							else if(rp.startsWith("a="))
							{
								totalAdded = totalAdded + rp.getSuffix("=").toLong();
							}
							else if(rp.startsWith("u="))
							{
								totalUpdated = totalUpdated + rp.getSuffix("=").toLong();
							}
							else if(rp.startsWith("d="))
							{
								totalDeleted = totalDeleted + rp.getSuffix("=").toLong();
							}
							else if(rp.startsWith("w="))
							{
								rW = rp.getSuffix("=");
							}
							else if(rp.startsWith("n="))
							{
								rowsProcessed = rowsProcessed + rp.getSuffix("=").toLong();
							}
						}
						if(rRes == "success")
						{
							successCount = successCount + 1;
						}
						else if(rRes == "partial")
						{
							partialCount = partialCount + 1;
						}
						else if(rRes == "failed")
						{
							failedCount = failedCount + 1;
						}
						else if(rRes == "skipped")
						{
							skippedCount = skippedCount + 1;
						}
						else if(rRes == "outofspec")
						{
							outOfSpecCount = outOfSpecCount + 1;
						}
						if(rW == "1")
						{
							repairedCount = repairedCount + 1;
						}
						if(rSt == "needsresync")
						{
							needsResyncLeft = needsResyncLeft + 1;
						}
						else if(rSt == "failed")
						{
							newlyFailedCount = newlyFailedCount + 1;
						}
					}
				}
			}
		}
		//
		// ---------- 4. 孤児ミラーの検出（親一覧に無い Parent_Record_Id）。消すかは sfr_sync_core の親不在判定に任せる ----------
		if(ORPHAN_SCAN == true && listingComplete == true && stopAll == false)
		{
			orphanMap = Map();
			orphanIds = List();
			mSlotStr = "".leftPad(MAX_MIRROR_PAGES).replaceAll(" ","x,");
			mSlotLen = mSlotStr.length() - 1;
			mSlotStr = mSlotStr.subString(0,mSlotLen);
			mPageSlots = mSlotStr.toList(",");
			lastMirrorId = "";
			mirrorDone = false;
			for each  mPageSlot in mPageSlots
			{
				if(mirrorDone == false)
				{
					mWhere = "id is not null";
					if(lastMirrorId != "")
					{
						mWhere = "id > '" + lastMirrorId + "'";
					}
					mq = "select id, Parent_Record_Id from " + MIRROR_MODULE + " where " + mWhere + " order by id asc limit " + MIRROR_PAGE_LIMIT;
					mBody = Map();
					mBody.put("select_query",mq);
					mBodyStr = mBody.toString();
					mResp = invokeurl
					[
						url :coqlUrl
						type :POST
						parameters:mBodyStr
						connection:"crm_module"
					];
					mStr = ifnull(mResp,"").toString();
					if(mStr == "")
					{
						mirrorDone = true;
					}
					else
					{
						mMap = mStr.toMap();
						mCode = ifnull(mMap.get("code"),"").toString();
						if(mCode != "")
						{
							mirrorDone = true;
							notes.add("MIRROR_SCAN_FAILED code=" + mCode);
						}
						else
						{
							mData = mMap.get("data");
							if(mData == null)
							{
								mirrorDone = true;
							}
							else
							{
								for each  mr in mData
								{
									mrId = ifnull(mr.get("id"),"").toString();
									mrPid = ifnull(mr.get("Parent_Record_Id"),"").toString().trim();
									if(mrId != "")
									{
										lastMirrorId = mrId;
									}
									if(mrPid != "")
									{
										if(parentSet.containKey(mrPid) == false)
										{
											if(orphanMap.containKey(mrPid) == false)
											{
												orphanMap.put(mrPid,1);
												orphanIds.add(mrPid);
											}
										}
									}
								}
								mInfo = mMap.get("info");
								mMore = "";
								if(mInfo != null)
								{
									mMore = ifnull(mInfo.get("more_records"),"").toString();
								}
								if(mMore != "true")
								{
									mirrorDone = true;
								}
							}
						}
					}
				}
			}
			if(mirrorDone == false)
			{
				notes.add("MIRROR_SCAN_TRUNCATED pages=" + MAX_MIRROR_PAGES);
			}
			orphanParentCount = orphanIds.size();
			for each  orphanId in orphanIds
			{
				if(stopAll == false)
				{
					if(orphanId.replaceAll("[0-9]","") != "")
					{
						orphanInvalidCount = orphanInvalidCount + 1;
					}
					else
					{
						nowMs = zoho.currenttime.toLong();
						elapsedSec = (nowMs - startMs) / 1000;
						if(processedCount >= MAX_PARENTS_PER_RUN)
						{
							stopAll = true;
							stopReason = "MAX_PARENTS_PER_RUN";
						}
						else if(elapsedSec >= DEADLINE_SEC)
						{
							stopAll = true;
							stopReason = "DEADLINE";
						}
						else
						{
							oRet = standalone.sfr_sync_core(orphanId,"reconcile");
							processedCount = processedCount + 1;
							oText = ifnull(oRet,"").toString();
							oParts = oText.toList(";");
							oRes = "";
							oSt = "";
							oNo = 0;
							for each  op in oParts
							{
								oNo = oNo + 1;
								if(oNo == 1)
								{
									oRes = op.replaceAll("_","");
								}
								else if(op.startsWith("st="))
								{
									oSt = op.getSuffix("=");
								}
								else if(op.startsWith("d="))
								{
									totalDeleted = totalDeleted + op.getSuffix("=").toLong();
								}
							}
							if(oSt == "gone" && oRes == "success")
							{
								orphanCleanedCount = orphanCleanedCount + 1;
							}
							else if(oRes == "failed" || oRes == "partial")
							{
								failedCount = failedCount + 1;
							}
						}
					}
				}
			}
		}
		else if(ORPHAN_SCAN == true)
		{
			notes.add("ORPHAN_SCAN_SKIPPED（親一覧が不完全、または打ち切り）");
		}
		//
		// ---------- 5. synced 以外（空を含む）の親を数える ----------
		nq = "select COUNT(id) from " + PARENT_MODULE + " where (Mirror_Sync_Status != 'synced' or Mirror_Sync_Status is null)";
		nBody = Map();
		nBody.put("select_query",nq);
		nBodyStr = nBody.toString();
		nResp = invokeurl
		[
			url :coqlUrl
			type :POST
			parameters:nBodyStr
			connection:"crm_module"
		];
		nStr = ifnull(nResp,"").toString();
		if(nStr != "")
		{
			nMap = nStr.toMap();
			nCode = ifnull(nMap.get("code"),"").toString();
			if(nCode != "")
			{
				notes.add("NON_SYNCED_COUNT_FAILED code=" + nCode);
			}
			else
			{
				nData = nMap.get("data");
				if(nData != null)
				{
					if(nData.size() > 0)
					{
						nFirst = nData.get(0);
						nonSyncedCount = ifnull(nFirst.get("COUNT(id)"),"").toString();
					}
				}
			}
		}
		//
		if(listingFailed == true)
		{
			runResult = "failed";
		}
		else if(stopAll == true || listingDone == false)
		{
			runResult = "timeout";
		}
		else
		{
			runResult = "success";
		}
	}
	catch (e)
	{
		runResult = "failed";
		exLine = e.lineNo;
		exMsg = e.message;
		notes.add("EXCEPTION line=" + exLine + " msg=" + exMsg);
	}
	//
	// ---------- 照合ログ1件と SFR_Sync_State の更新 ----------
	endedAt = zoho.currenttime.toString(ISO_FMT);
	completedFlag = "no";
	if(runResult == "success")
	{
		completedFlag = "yes";
	}
	staleFlag = "no";
	if(staleRun == true)
	{
		staleFlag = "yes";
	}
	parentTotal = parentIds.size();
	summary = "parents=" + parentTotal + " processed=" + processedCount + " repaired=" + repairedCount + " success=" + successCount + " partial=" + partialCount + " failed=" + failedCount + " no_change=" + skippedCount + " out_of_spec=" + outOfSpecCount + " needs_resync_left=" + needsResyncLeft + " newly_failed=" + newlyFailedCount + " skipped_failed=" + skippedFailedCount + " orphan_parents=" + orphanParentCount + " orphan_cleaned=" + orphanCleanedCount + " orphan_invalid=" + orphanInvalidCount + " rows=" + rowsProcessed + " non_synced_parents=" + nonSyncedCount + " completed=" + completedFlag + " stop_reason=" + stopReason + " prev_run_older_than_2_intervals=" + staleFlag + " prev_last_run=" + prevLastRun;
	detail = summary;
	for each  nt in notes
	{
		detail = detail + " / " + nt;
	}
	if(detail.length() > ERROR_DETAIL_MAX)
	{
		detail = detail.subString(0,ERROR_DETAIL_MAX);
	}
	try
	{
		logName = "RECON-" + runStamp;
		lr = Map();
		lr.put("Name",logName);
		lr.put("Sync_Source","reconcile");
		lr.put("Sync_Result",runResult);
		lr.put("Added_Count",totalAdded);
		lr.put("Updated_Count",totalUpdated);
		lr.put("Deleted_Count",totalDeleted);
		lr.put("Error_Detail",detail);
		lr.put("Started_At",startedAt);
		lr.put("Ended_At",endedAt);
		lList = List();
		lList.add(lr);
		lBody = Map();
		lBody.put("data",lList);
		lBody.put("trigger",List());
		lBodyStr = lBody.toString();
		lResp = invokeurl
		[
			url :logUrl
			type :POST
			parameters:lBodyStr
			connection:"crm_module"
		];
		lStr = ifnull(lResp,"").toString();
		lCode = "";
		if(lStr != "")
		{
			lMap = lStr.toMap();
			lData = lMap.get("data");
			if(lData != null)
			{
				if(lData.size() > 0)
				{
					lFirst = lData.get(0);
					lCode = ifnull(lFirst.get("code"),"").toString();
				}
			}
			else
			{
				lCode = ifnull(lMap.get("code"),"").toString();
			}
		}
		if(lCode != CODE_SUCCESS)
		{
			info "sfr_reconcile 照合ログの Insert 失敗: " + lStr;
		}
		//
		st = Map();
		st.put("Last_Run_At",endedAt);
		st.put("Last_Run_Result",runResult);
		stList = List();
		stBody = Map();
		if(stateId != "")
		{
			st.put("id",stateId);
			stList.add(st);
			stBody.put("data",stList);
			stBody.put("trigger",List());
			stBodyStr = stBody.toString();
			stResp = invokeurl
			[
				url :stateUrl
				type :PUT
				parameters:stBodyStr
				connection:"crm_module"
			];
		}
		else
		{
			st.put("Name",STATE_NAME);
			stList.add(st);
			stBody.put("data",stList);
			stBody.put("trigger",List());
			stBodyStr = stBody.toString();
			stResp = invokeurl
			[
				url :stateUrl
				type :POST
				parameters:stBodyStr
				connection:"crm_module"
			];
		}
		stStr = ifnull(stResp,"").toString();
		stCode = "";
		if(stStr != "")
		{
			stMap = stStr.toMap();
			stData = stMap.get("data");
			if(stData != null)
			{
				if(stData.size() > 0)
				{
					stFirst = stData.get(0);
					stCode = ifnull(stFirst.get("code"),"").toString();
				}
			}
			else
			{
				stCode = ifnull(stMap.get("code"),"").toString();
			}
		}
		if(stCode != CODE_SUCCESS)
		{
			info "sfr_reconcile SFR_Sync_State の更新失敗: " + stStr;
		}
	}
	catch (e2)
	{
		logExMsg = e2.message;
		info "sfr_reconcile ログ・状態の書き込みで例外: " + logExMsg;
	}
	info "sfr_reconcile 終了: result=" + runResult + " / " + detail;
}
